<Page x:Class="BioSAK.FlowCytometryAnalyzer"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:BioSAK.Localization"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="{loc:L Flow_Cytometry_Analyzer}"
      d:DesignHeight="720" d:DesignWidth="1400"
      Background="#F0F0F0" 
      Loaded="Window_Loaded" 
      KeyDown="Window_KeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <ToolBarTray Grid.Row="0" Background="#F5F5F5">
            <ToolBar Band="0" BandIndex="0" Background="#F5F5F5">
                <Button Content="{loc:L Open_xak}" Click="OpenXak_Click" Padding="8,4" 
                        Background="#607D8B" Foreground="White" ToolTip="{loc:L Open_saved_analysis_Ctrl_O}"/>
                <Button Content="{loc:L Save_xak}" Click="SaveXak_Click" Padding="8,4" 
                        Background="#00897B" Foreground="White" ToolTip="{loc:L Save_analysis_state_Ctrl_S}"/>
                <Separator/>
                <Button x:Name="btnLoadFile" Content="{loc:L Load_FCS}" Click="BtnLoadFile_Click" Padding="8,4"/>
                <Button x:Name="btnLoadDemo" Content="{loc:L Demo_FCS}" Click="BtnLoadDemo_Click" Padding="8,4"                        ToolTip="{loc:L Load_built_in_4_color_demo_FCS_file_FITC_PE}"/>
                <Separator/>
                <TextBlock Text="{loc:L File}" VerticalAlignment="Center" Margin="5,0"/>
                <ComboBox x:Name="cboFiles" Width="180" SelectionChanged="CboFiles_SelectionChanged"/>
                <Separator/>
                <CheckBox x:Name="chkOverlay" Content="{loc:L Overlay}" VerticalAlignment="Center" Margin="5,0"
                          Checked="ChkOverlay_Changed" Unchecked="ChkOverlay_Changed"/>
                <ComboBox x:Name="cboOverlay" Width="150" SelectionChanged="CboOverlay_SelectionChanged" 
                          Visibility="Collapsed"/>
                <Separator/>
                <Button x:Name="btnAddAnalysis" Content="{loc:L Add_Panel}" Click="BtnAddAnalysis_Click" 
                        Padding="8,4" Background="#DFF0D8"/>
                <Button x:Name="btnRemoveAnalysis" Content="{loc:L Remove_Panel}" Click="BtnRemoveAnalysis_Click" 
                        Padding="8,4" Background="#F2DEDE"/>
            </ToolBar>
        </ToolBarTray>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Control Panel -->
            <Border Grid.Column="0" Background="White" BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,5,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>
                        <!-- File Info -->
                        <TextBlock x:Name="txtFileInfo" Text="{loc:L No_file_loaded}" Foreground="#666666" 
                                   Margin="0,0,0,10" TextWrapping="Wrap"/>

                        <!-- View Type -->
                        <GroupBox Header="{loc:L View_Type}" Margin="0,0,0,10">
                            <StackPanel Margin="5">
                                <RadioButton x:Name="rbScatter" Content="{loc:L N2D_Scatter_Plot}" GroupName="ViewType"
                                             IsChecked="True" Checked="ViewType_Changed" Margin="0,0,0,5"/>
                                <RadioButton x:Name="rbHistogram" Content="{loc:L Histogram}" GroupName="ViewType"
                                             Checked="ViewType_Changed"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Scatter Plot Controls -->
                        <StackPanel x:Name="pnlScatterControls">
                            <GroupBox Header="{loc:L Axis_Settings}" Margin="0,0,0,10">
                                <StackPanel Margin="5">
                                    <TextBlock Text="{loc:L X_Axis_Parameter}" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="cboXParam" Margin="0,0,0,8" SelectionChanged="Param_Changed"/>

                                    <TextBlock Text="{loc:L Y_Axis_Parameter}" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="cboYParam" Margin="0,0,0,8" SelectionChanged="Param_Changed"/>

                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{loc:L X_Scale}" Margin="0,0,0,3"/>
                                            <ComboBox x:Name="cboXScale" SelectionChanged="Scale_Changed">
                                                <ComboBoxItem Content="Linear"/>
                                                <ComboBoxItem Content="Log" IsSelected="True"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{loc:L Y_Scale}" Margin="0,0,0,3"/>
                                            <ComboBox x:Name="cboYScale" SelectionChanged="Scale_Changed">
                                                <ComboBoxItem Content="Linear"/>
                                                <ComboBoxItem Content="Log" IsSelected="True"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="{loc:L Axis_Range_empty_auto}" Margin="0,0,0,10">
                                <StackPanel Margin="5">
                                    <TextBlock Text="{loc:L X_Range}" Margin="0,0,0,3"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="txtXMin" TextChanged="AxisRange_Changed" Tag="xmin"/>
                                        <TextBlock Text="~" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBox x:Name="txtXMax" Grid.Column="2" TextChanged="AxisRange_Changed" Tag="xmax"/>
                                    </Grid>

                                    <TextBlock Text="{loc:L Y_Range}" Margin="0,0,0,3"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="txtYMin" TextChanged="AxisRange_Changed" Tag="ymin"/>
                                        <TextBlock Text="~" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBox x:Name="txtYMax" Grid.Column="2" TextChanged="AxisRange_Changed" Tag="ymax"/>
                                    </Grid>
                                    <Button Content="{loc:L Reset_Range}" Click="BtnResetRange_Click" Padding="8,4"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="{loc:L Plot_Type_Colors}" Margin="0,0,0,10">
                                <StackPanel Margin="5">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <RadioButton x:Name="rbDotPlot" Content="{loc:L Dot_Plot}" GroupName="PlotType"
                                                     IsChecked="True" Checked="PlotType_Changed" Margin="0,0,15,0"/>
                                        <RadioButton x:Name="rbContourPlot" Content="{loc:L Contour_Plot}" GroupName="PlotType"
                                                     Checked="PlotType_Changed"/>
                                    </StackPanel>

                                    <TextBlock Text="{loc:L Dot_Colormap}" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="cboDotColormap" Margin="0,0,0,8" SelectionChanged="Colormap_Changed">
                                        <ComboBoxItem Content="Blue"/>
                                        <ComboBoxItem Content="Turbo" IsSelected="True"/>
                                        <ComboBoxItem Content="Viridis"/>
                                        <ComboBoxItem Content="Plasma"/>
                                        <ComboBoxItem Content="Inferno"/>
                                        <ComboBoxItem Content="Grayscale"/>
                                    </ComboBox>

                                    <TextBlock Text="{loc:L Contour_Colormap}" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="cboContourColormap" Margin="0,0,0,5" SelectionChanged="Colormap_Changed">
                                        <ComboBoxItem Content="YlOrRd" IsSelected="True"/>
                                        <ComboBoxItem Content="RdYlBu"/>
                                        <ComboBoxItem Content="Spectral"/>
                                        <ComboBoxItem Content="Hot"/>
                                        <ComboBoxItem Content="Cool"/>
                                        <ComboBoxItem Content="Grayscale"/>
                                    </ComboBox>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="{loc:L Gating}" Margin="0,0,0,10">
                                <StackPanel Margin="5">
                                    <TextBlock Text="{loc:L Mode}" Margin="0,0,0,3"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <RadioButton x:Name="rbModeView" Content="{loc:L View}" GroupName="GatingMode"
                                                     IsChecked="True" Checked="GatingMode_Changed" Margin="0,0,10,0"/>
                                        <RadioButton x:Name="rbModePolygon" Content="{loc:L Polygon}" GroupName="GatingMode"
                                                     Checked="GatingMode_Changed" Margin="0,0,10,0"/>
                                        <RadioButton x:Name="rbModeQuadrant" Content="{loc:L Quadrant}" GroupName="GatingMode"
                                                     Checked="GatingMode_Changed"/>
                                    </StackPanel>

                                    <Border x:Name="pnlPolygonTip" Background="#FFF3CD" BorderBrush="#FFEEBA" 
                                            BorderThickness="1" Padding="8" Margin="0,0,0,8" Visibility="Collapsed">
                                        <TextBlock Text="{loc:L Click_to_add_vertices_double_click_to_comple}" 
                                                   Foreground="#856404" FontSize="11" TextWrapping="Wrap"/>
                                    </Border>

                                    <!-- Parent Gate Selection -->
                                    <TextBlock Text="{loc:L Parent_Gate_filter_events}" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="cboParentGate" Margin="0,0,0,8" SelectionChanged="ParentGate_Changed">
                                        <ComboBoxItem Content="All Events" IsSelected="True"/>
                                    </ComboBox>

                                    <Border x:Name="pnlGateInfo" Background="#D4EDDA" BorderBrush="#C3E6CB"
                                            BorderThickness="1" Padding="8" Margin="0,0,0,8" Visibility="Collapsed">
                                        <TextBlock x:Name="txtGateInfo" Foreground="#155724" FontSize="11" TextWrapping="Wrap"/>
                                    </Border>

                                    <TextBlock Text="{loc:L Gate_List}" Margin="0,0,0,5"/>
                                    <ListBox x:Name="lstGates" MaxHeight="100" Margin="0,0,0,8">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" FontSize="11"/>
                                                    <Button Grid.Column="1" Content="✕" Padding="4,2"
                                                            Background="#F2DEDE" Foreground="#A94442"
                                                            Click="BtnRemoveGate_Click" Tag="{Binding}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- Gate Inheritance Section -->
                                    <Border Background="#E7F3FF" BorderBrush="#B8DAFF" BorderThickness="1" 
                                            Padding="8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{loc:L Gate_Inheritance}" FontWeight="SemiBold" 
                                                       Foreground="#004085" Margin="0,0,0,5"/>
                                            <TextBlock Text="{loc:L Apply_gate_regions_to_current_sample}" 
                                                       Foreground="#004085" FontSize="11" Margin="0,0,0,5"/>
                                            <CheckBox x:Name="chkAutoApplyGates" Content="{loc:L Auto_apply_on_file_switch}"
                                                      Margin="0,0,0,5" Checked="ChkAutoApplyGates_Changed" 
                                                      Unchecked="ChkAutoApplyGates_Changed"/>
                                            <Button x:Name="btnApplyGates" Content="{loc:L Apply_All_Gates_to_Current_Sample}" 
                                                    Click="BtnApplyGates_Click" Padding="6,4" Background="#CCE5FF"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>

                        <!-- Histogram Controls -->
                        <StackPanel x:Name="pnlHistogramControls" Visibility="Collapsed">
                            <GroupBox Header="{loc:L Histogram_Settings}" Margin="0,0,0,10">
                                <StackPanel Margin="5">
                                    <TextBlock Text="{loc:L Parameter}" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="cboHistParam" Margin="0,0,0,8" SelectionChanged="HistParam_Changed"/>

                                    <TextBlock Text="{loc:L Scale}" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="cboHistScale" Margin="0,0,0,8" SelectionChanged="HistScale_Changed">
                                        <ComboBoxItem Content="Linear"/>
                                        <ComboBoxItem Content="Log" IsSelected="True"/>
                                    </ComboBox>

                                    <TextBlock Text="{loc:L Color}" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="cboHistColor" Margin="0,0,0,8" SelectionChanged="Colormap_Changed">
                                        <ComboBoxItem Content="Blue" IsSelected="True"/>
                                        <ComboBoxItem Content="Red"/>
                                        <ComboBoxItem Content="Green"/>
                                        <ComboBoxItem Content="Orange"/>
                                        <ComboBoxItem Content="Purple"/>
                                        <ComboBoxItem Content="Gray"/>
                                    </ComboBox>
                                </StackPanel>
                            </GroupBox>

                            <!-- Histogram Gating -->
                            <GroupBox Header="{loc:L Histogram_Gating}" Margin="0,0,0,10">
                                <StackPanel Margin="5">
                                    <TextBlock Text="{loc:L Mode}" Margin="0,0,0,3"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <RadioButton x:Name="rbHistModeView" Content="{loc:L View}" GroupName="HistGatingMode"
                                                     IsChecked="True" Checked="HistGatingMode_Changed" Margin="0,0,10,0"/>
                                        <RadioButton x:Name="rbHistModeThreshold" Content="{loc:L Threshold}" GroupName="HistGatingMode"
                                                     Checked="HistGatingMode_Changed" Margin="0,0,10,0"/>
                                        <RadioButton x:Name="rbHistModeRange" Content="{loc:L Range_Gate}" GroupName="HistGatingMode"
                                                     Checked="HistGatingMode_Changed"/>
                                    </StackPanel>

                                    <Border x:Name="pnlHistGateTip" Background="#FFF3CD" BorderBrush="#FFEEBA" 
                                            BorderThickness="1" Padding="8" Margin="0,0,0,8" Visibility="Collapsed">
                                        <TextBlock x:Name="txtHistGateTip" Text="{loc:L Click_to_show_above_below_percentages}" 
                                                   Foreground="#856404" FontSize="11" TextWrapping="Wrap"/>
                                    </Border>

                                    <!-- Parent Gate Selection for Histogram -->
                                    <TextBlock Text="{loc:L Parent_Gate_filter_events}" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="cboHistParentGate" Margin="0,0,0,8" SelectionChanged="HistParentGate_Changed">
                                        <ComboBoxItem Content="All Events" IsSelected="True"/>
                                    </ComboBox>

                                    <Border x:Name="pnlHistGateInfo" Background="#D4EDDA" BorderBrush="#C3E6CB"
                                            BorderThickness="1" Padding="8" Margin="0,0,0,8" Visibility="Collapsed">
                                        <TextBlock x:Name="txtHistGateInfo" Foreground="#155724" FontSize="11" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>

                        <Button x:Name="btnClearAll" Content="{loc:L Clear_All_Gates}" Click="BtnClearAll_Click" 
                                Padding="8,6" Background="#F2DEDE" Margin="0,5,0,0"/>

                        <!-- Negative value warning (shown when Log scale active and events excluded) -->
                        <Border x:Name="pnlNegExcluded" Background="#FFF3CD" BorderBrush="#FFEEBA"
                                BorderThickness="1" Padding="8" Margin="0,8,0,0" Visibility="Collapsed">
                            <TextBlock Text="{loc:L Some_events_with_0_values_are_excluded_from}"
                                       Foreground="#856404" FontSize="11" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Compensation -->
                        <GroupBox Header="{loc:L Compensation}" Margin="0,8,0,0">
                            <StackPanel Margin="5">

                                <!-- Warning: no comp data -->
                                <Border x:Name="pnlCompWarn" Background="#FFF3CD" BorderBrush="#FFEEBA"
                                        BorderThickness="1" Padding="6" Margin="0,0,0,6" Visibility="Collapsed">
                                    <TextBlock x:Name="txtCompWarn"
                                               Text="{loc:L No_SPILLOVER_data_in_FCS_file}"
                                               Foreground="#856404" FontSize="11" TextWrapping="Wrap"/>
                                </Border>

                                <CheckBox x:Name="chkApplyCompensation" Content="{loc:L Apply_Compensation}"
                                          Margin="0,0,0,6"
                                          Checked="ChkCompensation_Changed"
                                          Unchecked="ChkCompensation_Changed"/>

                                <!-- Info / status row -->
                                <Border x:Name="pnlCompInfo" Background="#D4EDDA" BorderBrush="#C3E6CB"
                                        BorderThickness="1" Padding="6" Margin="0,0,0,6" Visibility="Collapsed">
                                    <TextBlock x:Name="txtCompInfo" Foreground="#155724" FontSize="11"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <Button x:Name="btnSetupChannels"
                                        Content="{loc:L Setup_Channels}"
                                        Click="BtnSetupChannels_Click"
                                        Padding="6,4" Background="#CCE5FF"
                                        Margin="0,0,0,6" Visibility="Collapsed"/>

                                <!-- Slider panel (shown when spillover data present) -->
                                <Border x:Name="pnlCompSliders" Visibility="Collapsed"
                                        BorderBrush="#CCCCCC" BorderThickness="1" Padding="4">
                                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="spCompSliders"/>
                                    </ScrollViewer>
                                </Border>

                                <Button Content="{loc:L Reset_Compensation}" Click="BtnResetCompensation_Click"
                                        Padding="6,4" Background="#F2DEDE" Margin="0,4,0,0"/>

                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" 
                          VerticalAlignment="Stretch" Background="#E0E0E0"/>

            <!-- Right: Multi-Analysis Panels -->
            <TabControl x:Name="tabAnalysis" Grid.Column="2">
                <TabItem x:Name="tabItem1" Header="{loc:L Panel_1}">
                    <Grid Background="White">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid ClipToBounds="True">
                            <Canvas x:Name="plotCanvas" Background="White" ClipToBounds="True"
                                    MouseLeftButtonDown="PlotCanvas_MouseLeftButtonDown"
                                    MouseLeftButtonUp="PlotCanvas_MouseLeftButtonUp"
                                    MouseMove="PlotCanvas_MouseMove"
                                    MouseRightButtonDown="PlotCanvas_MouseRightButtonDown"/>
                            <Canvas x:Name="rubberBandCanvas" Background="Transparent"
                                    IsHitTestVisible="False" ClipToBounds="True"/>
                        </Grid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5">
                            <Button x:Name="btnPrevSample" Content="{loc:L Prev_Ctrl_P}" Click="BtnPrevSample_Click" 
                                    Padding="10,5" Background="#E8E8E8" Margin="0,0,8,0" ToolTip="{loc:L Previous_sample}"/>
                            <Button x:Name="btnNextSample" Content="{loc:L Next_Ctrl_N}" Click="BtnNextSample_Click" 
                                    Padding="10,5" Background="#E8E8E8" Margin="0,0,8,0" ToolTip="{loc:L Next_sample}"/>
                            <Separator Margin="8,0"/>
                            <Button x:Name="btnExportDot" Content="{loc:L Export_Dot_Plot}" Click="BtnExportDot_Click" 
                                    Padding="10,5" Background="#DFF0D8" Margin="0,0,8,0"/>
                            <Button x:Name="btnExportContour" Content="{loc:L Export_Contour_Plot}" Click="BtnExportContour_Click" 
                                    Padding="10,5" Background="#DFF0D8" Margin="0,0,8,0"/>
                            <Button x:Name="btnExportHistogram" Content="{loc:L Export_Histogram}" Click="BtnExportHistogram_Click" 
                                    Padding="10,5" Background="#DFF0D8" Visibility="Collapsed"/>
                            <Separator Margin="8,0"/>
                            <Button x:Name="btnRecordStats" Content="{loc:L Record_Ctrl_M}" Click="BtnRecordStats_Click" 
                                    Padding="10,5" Background="#FCF8E3" ToolTip="{loc:L Record_current_gating_statistics_to_table}"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Statistics Record Panel (auto-expands on record) -->
        <Border x:Name="pnlStats" Grid.Row="2" Margin="5,5,5,0" Background="White" 
                BorderBrush="#CCCCCC" BorderThickness="1" Visibility="Collapsed">
            <Grid Height="180">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="dgStats" Grid.Row="0" AutoGenerateColumns="False" 
                          CanUserAddRows="False" IsReadOnly="True"
                          GridLinesVisibility="All" AlternatingRowBackground="#F9F9F9"
                          HeadersVisibility="Column" FontSize="11">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:L Sample}" Binding="{Binding SampleName}" Width="120"/>
                        <DataGridTextColumn Header="{loc:L View}" Binding="{Binding ViewType}" Width="70"/>
                        <DataGridTextColumn Header="{loc:L Parameter_s}" Binding="{Binding Parameters}" Width="140"/>
                        <DataGridTextColumn Header="{loc:L Gate_Region}" Binding="{Binding GateRegion}" Width="100"/>
                        <DataGridTextColumn Header="{loc:L Count}" Binding="{Binding Count}" Width="70"/>
                        <DataGridTextColumn Header="%" Binding="{Binding Percentage}" Width="60"/>
                        <DataGridTextColumn Header="{loc:L Parent}" Binding="{Binding ParentGate}" Width="80"/>
                        <DataGridTextColumn Header="{loc:L Details}" Binding="{Binding Details}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5">
                    <Button x:Name="btnClearStats" Content="{loc:L Clear_All}" Click="BtnClearStats_Click" 
                            Padding="8,4" Background="#F2DEDE" Margin="0,0,8,0"/>
                    <Button x:Name="btnExportStats" Content="{loc:L Export_to_CSV}" Click="BtnExportStats_Click" 
                            Padding="8,4" Background="#DFF0D8" Margin="0,0,8,0"/>
                    <Button x:Name="btnCopyStats" Content="{loc:L Copy_to_Clipboard}" Click="BtnCopyStats_Click" 
                            Padding="8,4" Background="#D9EDF7" Margin="0,0,8,0"/>
                    <Button x:Name="btnHideStats" Content="{loc:L Hide}" Click="BtnHideStats_Click" 
                            Padding="8,4" Background="#E8E8E8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" Text="{loc:L Ready_Load_an_FCS_file_or_demo_data_to_begin}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar x:Name="progressBar" Width="150" Height="14" Visibility="Collapsed" Minimum="0" Maximum="100"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Page>
