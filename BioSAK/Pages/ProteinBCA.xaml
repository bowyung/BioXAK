<Page x:Class="BioSAK.Pages.ProteinBCA"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:BioSAK.Localization"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="{loc:L Protein_BCA_Calculator}">

    <Page.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="True"/>
            <Setter Property="CanUserDeleteRows" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HeadersVisibility" Value="All"/>
            <Setter Property="RowHeaderWidth" Value="25"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="SelectionUnit" Value="CellOrRowHeader"/>
        </Style>
    </Page.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="{loc:L Global_Settings_Controls}" Margin="0,0,0,10" Background="#F9F9F9">
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="{loc:L Global_Dilution_x}" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBox x:Name="TxtGlobalDilution" Width="50" Margin="5,0,15,0" Text="1" TextAlignment="Center" Background="White"/>

                <TextBlock Text="{loc:L Target_g}" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtTargetMass" Width="50" Margin="5,0" Text="20" TextAlignment="Center" Background="White"/>

                <TextBlock Text="{loc:L Total_Vol_L}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBox x:Name="TxtTotalVol" Width="50" Margin="5,0" Text="20" TextAlignment="Center" Background="White"/>

                <TextBlock Text="{loc:L Buffer}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <ComboBox x:Name="ComboBuffer" Width="60" Margin="5,0" SelectedIndex="3">
                    <ComboBoxItem Content="2x"/>
                    <ComboBoxItem Content="3x"/>
                    <ComboBoxItem Content="4x"/>
                    <ComboBoxItem Content="5x"/>
                    <ComboBoxItem Content="6x"/>
                </ComboBox>

                <Button Content="{loc:L CALCULATE_ALL}" FontWeight="Bold" Background="#E0F7FA" Margin="30,0,0,0" Padding="20,5" Click="CalculateAll_Click"/>
            </StackPanel>
        </GroupBox>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="{loc:L N1_Samples_Input_OD_Values}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{loc:L Paste_Support_Click_any_cell_e_g_OD1_and_Ctr}" Foreground="#666" FontSize="11" Margin="2"/>

                        <DataGrid x:Name="GridSamples" Grid.Row="1" KeyDown="GridSamples_KeyDown">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{loc:L Delete_Selected_Row}" Click="DeleteSampleRow_Click"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:L ID}" Binding="{Binding ID}" Width="60"/>
                                <DataGridTextColumn Header="{loc:L OD_1}" Binding="{Binding OD1}" Width="80"/>
                                <DataGridTextColumn Header="{loc:L OD_2}" Binding="{Binding OD2}" Width="80"/>
                                <DataGridTextColumn Header="{loc:L Conc_g_L}" Binding="{Binding CalculatedConc, StringFormat=N2}" IsReadOnly="True" Foreground="Red" FontWeight="Bold" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </GroupBox>

                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="#EEE"/>

                <GroupBox Grid.Row="2" Header="{loc:L N3_Recipe_Calculation_Result}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button Content="{loc:L Copy_Recipe_Table}" Click="CopyRecipe_Click" HorizontalAlignment="Left" Margin="2" Height="22" Padding="10,0"/>

                        <DataGrid x:Name="GridRecipe" Grid.Row="1" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:L ID}" Binding="{Binding SampleID}" Width="60"/>
                                <DataGridTextColumn Header="{loc:L Sample_L}" Binding="{Binding SampleVol, StringFormat=N1}" Width="90" FontWeight="Bold"/>
                                <DataGridTextColumn Header="{loc:L Water_L}" Binding="{Binding WaterVol, StringFormat=N1}" Width="80"/>
                                <DataGridTextColumn Header="{loc:L Buffer_L}" Binding="{Binding BufferVol, StringFormat=N1}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </GroupBox>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="250"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="#AAA" BorderThickness="1" Background="White" Margin="0,0,0,10">
                    <Grid>
                        <TextBlock Text="{loc:L Conc}" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="-90"/>
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                        <TextBlock Text="{loc:L OD_Absorbance}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <Canvas x:Name="ChartCanvas" Margin="30,10,10,30" ClipToBounds="True" Background="#FAFAFA"/>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,20,0" Background="#DDFFFFFF">
                            <TextBlock x:Name="EquationText" Text="{loc:L y_ax_b}" FontWeight="Bold" Foreground="DarkRed"/>
                            <TextBlock x:Name="R2Text" Text="R² = ---" FontSize="11" Foreground="#666"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <GroupBox Grid.Row="1" Header="{loc:L N2_Standard_Curve}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{loc:L Tip_Select_start_cell_to_paste}" Foreground="#888" FontSize="10" Margin="2"/>

                        <DataGrid x:Name="GridStandards" Grid.Row="1" KeyDown="GridStandards_KeyDown">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{loc:L Delete_Selected_Row}" Click="DeleteStandardRow_Click"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:L Conc_ng_L}" Binding="{Binding Concentration}" Width="*"/>
                                <DataGridTextColumn Header="{loc:L OD_1}" Binding="{Binding OD1}" Width="60"/>
                                <DataGridTextColumn Header="{loc:L OD_2}" Binding="{Binding OD2}" Width="60"/>
                                <DataGridTextColumn Header="{loc:L Avg}" Binding="{Binding Average, StringFormat=N3}" IsReadOnly="True" Width="50" Foreground="Blue"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </GroupBox>
            </Grid>

        </Grid>
    </Grid>
</Page>