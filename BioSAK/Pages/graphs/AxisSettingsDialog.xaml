<Window x:Class="BioSAK.AxisSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:BioSAK.Localization"
        Title="{loc:L Axis_Settings}" 
        SizeToContent="Height" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">
    
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="TitleText" Text="{loc:L Y_Axis_Settings}" FontSize="18" FontWeight="Bold" 
                       Foreground="#333" Margin="0,0,0,15"/>

            <!-- Scale Settings -->
            <GroupBox Grid.Row="1" Header="{loc:L Scale_2}" Padding="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <CheckBox Grid.Row="0" Grid.ColumnSpan="2" x:Name="AutoScaleCheck" 
                              Content="{loc:L Auto_Scale_round_to_nice_numbers}" IsChecked="True" Margin="0,0,0,8"/>

                    <CheckBox Grid.Row="1" Grid.ColumnSpan="2" x:Name="LogScaleCheck" 
                              Content="{loc:L Logarithmic_Scale_Log10}" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:L Minimum}" VerticalAlignment="Center" Margin="0,0,10,5"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="MinValueBox" Text="0" Width="100" 
                             HorizontalAlignment="Left" Margin="0,0,0,5" IsEnabled="False"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:L Maximum}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="MaxValueBox" Text="100" Width="100" 
                             HorizontalAlignment="Left" IsEnabled="False"/>
                </Grid>
            </GroupBox>

            <!-- Tick Marks / Scale Lines -->
            <GroupBox Grid.Row="2" Header="{loc:L Tick_Marks}" Padding="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Main Scale -->
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{loc:L Main_Scale_Major_Ticks}" 
                               FontWeight="SemiBold" Margin="0,0,0,5"/>
                    
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:L Interval}" VerticalAlignment="Center" Margin="15,0,10,5"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBox x:Name="MainScaleIntervalBox" Text="0" Width="60"/>
                        <TextBlock Text="{loc:L N0_auto}" Foreground="#888" Margin="5,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Sub Scale -->
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{loc:L Sub_Scale_Minor_Ticks}" 
                               FontWeight="SemiBold" Margin="0,10,0,5"/>
                    
                    <CheckBox Grid.Row="3" Grid.ColumnSpan="2" x:Name="ShowSubScaleCheck" 
                              Content="{loc:L Show_minor_ticks}" Margin="15,0,0,5"/>
                    
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:L Divisions}" VerticalAlignment="Center" Margin="15,0,10,0"/>
                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="SubScaleDivisionsBox" Text="5" Width="60" IsEnabled="False"/>
                        <TextBlock Text="{loc:L per_major_tick}" Foreground="#888" Margin="5,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- Grid Lines -->
            <GroupBox Grid.Row="3" Header="{loc:L Grid_Lines}" Padding="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <CheckBox Grid.Row="0" Grid.ColumnSpan="2" x:Name="ShowGridLinesCheck" 
                              Content="{loc:L Show_Grid_Lines_at_major_ticks}" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:L Line_Style}" VerticalAlignment="Center" Margin="0,0,10,5"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="GridLineStyleCombo" Width="120" 
                              HorizontalAlignment="Left" Margin="0,0,0,5" IsEnabled="False">
                        <ComboBoxItem Content="Solid" IsSelected="True"/>
                        <ComboBoxItem Content="Dashed"/>
                        <ComboBoxItem Content="Dotted"/>
                    </ComboBox>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:L Line_Color}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                        <Border x:Name="GridLineColorPreview" Width="30" Height="20" Background="#E0E0E0" 
                                BorderBrush="#999" BorderThickness="1" Cursor="Hand"
                                MouseLeftButtonDown="GridLineColorPreview_Click"/>
                        <Button Content="{loc:L Choose}" Padding="5,2" Margin="10,0,0,0" 
                                x:Name="GridLineColorBtn" Click="GridLineColor_Click" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- Axis Break (Segment) -->
            <GroupBox Grid.Row="4" Header="{loc:L Axis_Break_Segment}" Padding="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <CheckBox Grid.Row="0" Grid.ColumnSpan="2" x:Name="EnableBreakCheck" 
                              Content="{loc:L Enable_Axis_Break}" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:L Break_Start}" VerticalAlignment="Center" Margin="0,0,10,5"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="BreakStartBox" Text="0" Width="100" 
                             HorizontalAlignment="Left" Margin="0,0,0,5" IsEnabled="False"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:L Break_End}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="BreakEndBox" Text="0" Width="100" 
                             HorizontalAlignment="Left" IsEnabled="False"/>
                </Grid>
            </GroupBox>

            <!-- Axis Title -->
            <GroupBox Grid.Row="5" Header="{loc:L Axis_Title}" Padding="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{loc:L Title}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" x:Name="AxisTitleBox" Text="" />
                </Grid>
            </GroupBox>

            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="{loc:L Cancel}" Width="80" Padding="5,8" Margin="0,0,10,0"
                        Background="#9E9E9E" Foreground="White" BorderThickness="0"
                        Cursor="Hand" Click="Cancel_Click"/>
                <Button Content="{loc:L OK}" Width="80" Padding="5,8"
                        Background="#4CAF50" Foreground="White" BorderThickness="0"
                        Cursor="Hand" Click="OK_Click"/>
            </StackPanel>
        </Grid>
</Window>
