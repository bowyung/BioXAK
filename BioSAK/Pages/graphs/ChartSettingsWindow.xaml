<Window x:Class="BioSAK.ChartSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:BioSAK.Localization"
        Title="{loc:L Chart_Settings}" 
        Height="820" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Settings -->
        <GroupBox Grid.Row="0" Header="{loc:L Titles}" Margin="0,0,0,15" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:L Main_Title}" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="ChartTitleBox" Margin="0,5"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:L Subtitle}" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="ChartSubtitleBox" Margin="0,5"/>

                <TextBlock Grid.Row="1" Grid.Column="1" Text="{loc:L Use_in_Main_Title_for_two_lines}" 
                           FontSize="10" Foreground="#888" VerticalAlignment="Bottom" 
                           HorizontalAlignment="Right" Margin="0,0,0,-2"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:L X_Axis_Title}" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="XAxisTitleBox" Margin="0,5"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:L Y_Axis_Title}" VerticalAlignment="Center"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="YAxisTitleBox" Margin="0,5"/>
            </Grid>
        </GroupBox>

        <!-- Chart Type -->
        <GroupBox Grid.Row="1" Header="{loc:L Chart_Type}" Margin="0,0,0,15" Padding="10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="LineTypeRadio" Content="Line" Margin="0,0,20,0"/>
                    <RadioButton x:Name="ScatterTypeRadio" Content="Scatter" Margin="0,0,20,0"/>
                    <RadioButton x:Name="VolcanoTypeRadio" Content="Volcano"/>
                </StackPanel>
                <CheckBox x:Name="ConnectLinesCheck" Content="{loc:L Connect_scatter_points_with_lines}" 
                          Margin="0,8,0,0" Foreground="#555"/>
            </StackPanel>
        </GroupBox>

        <!-- Regression / Trendline -->
        <GroupBox Grid.Row="2" Header="{loc:L Regression_Trendline}" Margin="0,0,0,15" Padding="10">
            <StackPanel>
                <CheckBox x:Name="RegressionCheck" Content="{loc:L Show_regression_line}" Margin="0,0,0,8"
                          Checked="RegressionCheck_Changed" Unchecked="RegressionCheck_Changed"/>
                <StackPanel x:Name="RegressionOptions" Orientation="Vertical" Margin="20,0,0,0"
                            IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="{loc:L Polynomial_Degree}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Slider x:Name="DegreeSlider" Width="120" Minimum="1" Maximum="6" 
                                Value="1" TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="Degree_Changed"/>
                        <TextBlock x:Name="DegreeLabel" Text="1" Margin="8,0,0,0" 
                                   VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DegreeHint" Text="{loc:L Linear_2}" Margin="5,0,0,0" 
                                   VerticalAlignment="Center" Foreground="#999" FontSize="11"/>
                    </StackPanel>
                    <CheckBox x:Name="ShowEquationCheck" Content="{loc:L Show_equation_R_on_chart}" 
                              IsChecked="True" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Axis Settings -->
        <GroupBox Grid.Row="3" Header="{loc:L Axis_Settings}" Margin="0,0,0,15" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- X Axis -->
                <GroupBox Grid.Row="0" Header="{loc:L X_Axis}" Margin="0,0,0,8" Padding="8" FontSize="11">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <CheckBox x:Name="XAutoScale" Content="{loc:L Auto}" IsChecked="True" 
                                      Checked="AxisAuto_Changed" Unchecked="AxisAuto_Changed" 
                                      VerticalAlignment="Center" Margin="0,0,15,0"/>
                            <TextBlock Text="{loc:L Min_2}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="XMinBox" Text="" Width="60" Margin="0,0,10,0" IsEnabled="False"/>
                            <TextBlock Text="{loc:L Max_2}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="XMaxBox" Text="" Width="60" Margin="0,0,10,0" IsEnabled="False"/>
                            <TextBlock Text="{loc:L Interval}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="XIntervalBox" Text="" Width="50" IsEnabled="False"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="XLogScale" Content="{loc:L Log_Scale}" Margin="0,0,10,0"
                                      Checked="LogScale_Changed" Unchecked="LogScale_Changed"/>
                            <TextBlock Text="{loc:L Base}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="XLogBase" Text="10" Width="40" IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Y Axis -->
                <GroupBox Grid.Row="1" Header="{loc:L Y_Axis}" Padding="8" FontSize="11">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <CheckBox x:Name="YAutoScale" Content="{loc:L Auto}" IsChecked="True" 
                                      Checked="AxisAuto_Changed" Unchecked="AxisAuto_Changed"
                                      VerticalAlignment="Center" Margin="0,0,15,0"/>
                            <TextBlock Text="{loc:L Min_2}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="YMinBox" Text="" Width="60" Margin="0,0,10,0" IsEnabled="False"/>
                            <TextBlock Text="{loc:L Max_2}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="YMaxBox" Text="" Width="60" Margin="0,0,10,0" IsEnabled="False"/>
                            <TextBlock Text="{loc:L Interval}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="YIntervalBox" Text="" Width="50" IsEnabled="False"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="YLogScale" Content="{loc:L Log_Scale}" Margin="0,0,10,0"
                                      Checked="LogScale_Changed" Unchecked="LogScale_Changed"/>
                            <TextBlock Text="{loc:L Base}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="YLogBase" Text="10" Width="40" IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </Grid>
        </GroupBox>

        <!-- Series Settings -->
        <GroupBox Grid.Row="4" Header="{loc:L Series_Settings}" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ComboBox Grid.Row="0" x:Name="SeriesSelector" Margin="0,0,0,10"
                          SelectionChanged="SeriesSelector_SelectionChanged"/>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Color -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:L Color}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
                        <Border x:Name="ColorPreview" Width="30" Height="25" BorderBrush="#CCC" 
                                BorderThickness="1" CornerRadius="3" Margin="0,0,10,0"/>
                        <Button Content="{loc:L Choose}" Padding="10,3" Click="ChooseColor_Click"/>
                    </StackPanel>

                    <!-- Line Thickness -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:L Line_Width}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
                        <Slider x:Name="LineThicknessSlider" Width="150" Minimum="1" Maximum="10" 
                                Value="2" TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="LineThickness_Changed"/>
                        <TextBlock x:Name="LineThicknessLabel" Text="2" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Marker Size -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:L Marker_Size}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,5">
                        <Slider x:Name="MarkerSizeSlider" Width="150" Minimum="4" Maximum="20" 
                                Value="8" TickFrequency="2" IsSnapToTickEnabled="True"
                                ValueChanged="MarkerSize_Changed"/>
                        <TextBlock x:Name="MarkerSizeLabel" Text="8" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Marker Shape -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:L Marker_Shape}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="3" Grid.Column="1" x:Name="MarkerShapeCombo" Margin="0,5"
                              SelectionChanged="MarkerShape_Changed">
                        <ComboBoxItem Content="Circle" IsSelected="True"/>
                        <ComboBoxItem Content="Square"/>
                        <ComboBoxItem Content="Triangle"/>
                        <ComboBoxItem Content="Diamond"/>
                    </ComboBox>
                </Grid>
            </Grid>
        </GroupBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="{loc:L Cancel}" Width="80" Padding="5,8" Margin="0,0,10,0"
                    Background="#EEE" BorderThickness="0" Cursor="Hand"
                    Click="Cancel_Click"/>
            <Button Content="{loc:L Apply}" Width="80" Padding="5,8"
                    Background="#4FC3F7" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Click="Apply_Click"/>
        </StackPanel>
    </Grid>
</Window>
